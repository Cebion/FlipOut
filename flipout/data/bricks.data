color_scheme "bright"
{
	color "blue"
	{
		color 0.30 0.30 1.00;
	};
	color "green"
	{
		color 0.30 1.00 0.30;
	};
	color "red"
	{
		color 1.00 0.30 0.30;
	};
};

technique "glowing brick.tech"
{
	pass "glow"
	{
		shader "brick glow.shader";
	};
	pass "noshader";
	pass "shadow"
	{
		use_textures false;
	};
	pass "light";
};

