technique "bonus.tech"
{
	material "default material";
	texture_slot "texture";
	pass "glow";
	pass "noshader";
	pass "shadow"
	{
		use_textures false;
	};
	pass "light";
};

bonus "small score"
{
	probability 2.0;
	score 80;
	text "80";

	mesh "capsule.mesh";
	technique "bonus.tech";
	texture "cash 1.png";

	collect_sound "cash.ogg";
};

